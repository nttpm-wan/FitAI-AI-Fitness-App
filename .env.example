# Optional. Without these values, FITAI runs in local-only mode and stores data on this device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exercise API. For a physical phone, use the development computer's LAN IP.
EXPO_PUBLIC_EXERCISE_API_BASE_URL=http://10.0.2.2:8001

# Optional pose server HTTP base URL; enter the one-time pairing code in the Camera AI screen.
EXPO_PUBLIC_POSE_API_BASE_URL=
